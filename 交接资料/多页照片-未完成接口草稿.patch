+/** Copy before crossing the async bridge; a late UI edit must not alter this request. */
+function photoView(value?: PhotoView): PhotoView {
+  if (value === undefined) return { version: 1, rotation: 0, crop: { x: 0, y: 0, width: 1, height: 1 } };
+  const crop = value?.crop;
+  if (!value || Object.keys(value).sort().join() !== 'crop,rotation,version' || value.version !== 1 || ![0, 90, 180, 270].includes(value.rotation) || !crop || Object.keys(crop).sort().join() !== 'height,width,x,y'
+    || ![crop.x, crop.y, crop.width, crop.height].every(item => typeof item === 'number' && Number.isFinite(item))
+    || crop.x < 0 || crop.y < 0 || crop.width <= 0 || crop.height <= 0 || crop.x + crop.width > 1 || crop.y + crop.height > 1) throw new Error('图片裁框或方向无效，请重新调整。');
+  return { version: 1, rotation: value.rotation, crop: { x: crop.x, y: crop.y, width: crop.width, height: crop.height } };
+}
+
+function updatedModule() {
+  if (!XiaoheOcr) throw new Error(unavailable);
+  if (typeof XiaoheOcr.inspect !== 'function') throw new Error(outdated);
+  return XiaoheOcr;
+}
+
+function validSize(width: number, height: number) {
+  return Number.isInteger(width) && Number.isInteger(height) && width > 0 && height > 0 && width <= 16000 && height <= 16000 && width * height <= 48_000_000;
+}
 
 export async function getOcrAvailability(): Promise<OcrAvailability> {
