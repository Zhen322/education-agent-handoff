+export async function recognizePhoto(uri: string, view?: PhotoView): Promise<NativeOcrResult> {
+  const requested = photoView(view);
+  const result = await updatedModule().recognize(uri, requested);
+  // An older binary must never silently recognize the whole page instead of the crop.
+  if (!result || !validSize(result.sourceWidth, result.sourceHeight) || JSON.stringify(photoView(result.view)) !== JSON.stringify(requested) || !result.view || !/^[a-f0-9]{64}$/.test(result.imageDigest)) throw new Error('识别模块返回的图片范围不完整，请更新安装包或重试。');
+  return result;
+}
+
+export async function inspectPhoto(uri: string): Promise<PhotoInspection> {
